# Frontend (Vite) — copy to .env.local and fill in from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# CLI / scripts (never commit real values; use shell env or .env.local)
# SUPABASE_ACCESS_TOKEN=   # optional: for supabase link without browser login
# SUPABASE_SERVICE_ROLE_KEY=   # for scripts/migrate-trainer-auth.mjs only
